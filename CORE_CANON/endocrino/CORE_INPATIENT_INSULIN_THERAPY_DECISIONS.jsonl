{"id":"INS_HOSP_001","tema":"Medicina interna","subtema":"Insulinoterapia hospitalaria","tipo_decision":"prioridad","enunciado":"Paciente hospitalizado no crítico con DM2 y glucemias persistentemente elevadas. ¿Cuál es el esquema recomendado?","opciones":[{"id":"A","texto":"Basal–bolo–corrección","resultado":"correcto","impacto":3},{"id":"B","texto":"Escala móvil como único esquema","resultado":"error_grave","impacto":-4},{"id":"C","texto":"Suspender hipoglucemiantes y observar","resultado":"error_frecuente","impacto":-2}],"fuentes":["ADA Inpatient Glycemic Management"],"version":"core_v2.8"}

{"id":"INS_HOSP_002","tema":"Medicina interna","subtema":"Insulinoterapia hospitalaria","tipo_decision":"seguridad","enunciado":"¿Cuál es el principal riesgo del uso exclusivo de escala móvil de insulina?","opciones":[{"id":"A","texto":"Hiperglucemia sostenida y mayor morbilidad","resultado":"correcto","impacto":3},{"id":"B","texto":"Hipoglucemia severa inmediata","resultado":"error_frecuente","impacto":-2},{"id":"C","texto":"Cetoacidosis diabética","resultado":"error_grave","impacto":-4}],"fuentes":["ADA Standards of Care"],"version":"core_v2.8"}

{"id":"INS_HOSP_003","tema":"Medicina interna","subtema":"Insulinoterapia hospitalaria","tipo_decision":"seguridad","enunciado":"Paciente en ayuno para procedimiento quirúrgico. ¿Cómo debe ajustarse la insulina basal?","opciones":[{"id":"A","texto":"Continuar a dosis reducida (50–80%)","resultado":"correcto","impacto":3},{"id":"B","texto":"Suspender completamente la basal","resultado":"error_letal","impacto":-6},{"id":"C","texto":"Duplicar la dosis para evitar hiperglucemia","resultado":"error_grave","impacto":-4}],"fuentes":["ADA Perioperative Management"],"version":"core_v2.8"}

{"id":"INS_HOSP_004","tema":"Medicina interna","subtema":"Insulinoterapia hospitalaria","tipo_decision":"reconocimiento","enunciado":"Paciente hospitalizado con diaforesis, confusión y taquicardia. Glucosa capilar 48 mg/dl. ¿Cuál es la prioridad?","opciones":[{"id":"A","texto":"Administrar glucosa IV inmediata","resultado":"correcto","impacto":3},{"id":"B","texto":"Reducir dosis de insulina para el día siguiente","resultado":"error_grave","impacto":-4},{"id":"C","texto":"Esperar confirmación en laboratorio","resultado":"error_letal","impacto":-6}],"fuentes":["ADA Hypoglycemia Management"],"version":"core_v2.8"}

{"id":"INS_HOSP_005","tema":"Medicina interna","subtema":"Insulinoterapia hospitalaria","tipo_decision":"clasificacion","enunciado":"¿Cuál es la meta glucémica recomendada para pacientes hospitalizados no críticos?","opciones":[{"id":"A","texto":"140–180 mg/dl","resultado":"correcto","impacto":3},{"id":"B","texto":"90–110 mg/dl","resultado":"error_grave","impacto":-4},{"id":"C","texto":"<200 mg/dl sin límite inferior","resultado":"error_frecuente","impacto":-2}],"fuentes":["ADA Inpatient Targets"],"version":"core_v2.8"}

