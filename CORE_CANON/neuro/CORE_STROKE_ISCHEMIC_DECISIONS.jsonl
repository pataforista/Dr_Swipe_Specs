{"id":"STROKE_001","tema":"Urgencias","subtema":"EVC isquémico","tipo_decision":"prioridad","enunciado":"Paciente con déficit neurológico focal súbito. ¿Cuál es el primer estudio de imagen que debe solicitarse?","opciones":[{"id":"A","texto":"TAC simple de cráneo","resultado":"correcto","impacto":3},{"id":"B","texto":"Resonancia magnética","resultado":"error_grave","impacto":-4},{"id":"C","texto":"Angio-TAC cerebral","resultado":"error_frecuente","impacto":-2}],"fuentes":["AHA/ASA Stroke Guidelines"],"version":"core_v2.9"}

{"id":"STROKE_002","tema":"Urgencias","subtema":"EVC isquémico","tipo_decision":"clasificacion","enunciado":"¿Cuál es el objetivo principal del TAC simple inicial en un EVC agudo?","opciones":[{"id":"A","texto":"Descartar hemorragia intracraneal","resultado":"correcto","impacto":3},{"id":"B","texto":"Confirmar el territorio isquémico","resultado":"error_frecuente","impacto":-2},{"id":"C","texto":"Evaluar penumbra isquémica","resultado":"error_grave","impacto":-4}],"fuentes":["AHA/ASA"],"version":"core_v2.9"}

{"id":"STROKE_003","tema":"Urgencias","subtema":"EVC isquémico","tipo_decision":"prioridad","enunciado":"Paciente con EVC isquémico confirmado, inicio de síntomas hace 2 horas. ¿Cuál es la intervención tiempo-dependiente indicada?","opciones":[{"id":"A","texto":"Trombólisis IV con alteplasa si no hay contraindicaciones","resultado":"correcto","impacto":3},{"id":"B","texto":"Iniciar AAS inmediatamente","resultado":"error_grave","impacto":-4},{"id":"C","texto":"Esperar evolución clínica","resultado":"error_letal","impacto":-6}],"fuentes":["AHA/ASA Thrombolysis"],"version":"core_v2.9"}

{"id":"STROKE_004","tema":"Urgencias","subtema":"EVC isquémico","tipo_decision":"seguridad","enunciado":"¿Cuál de los siguientes es una contraindicación absoluta para trombólisis IV?","opciones":[{"id":"A","texto":"Hemorragia intracraneal previa","resultado":"correcto","impacto":3},{"id":"B","texto":"Edad mayor de 80 años","resultado":"error_frecuente","impacto":-2},{"id":"C","texto":"Diabetes mellitus","resultado":"error_grave","impacto":-4}],"fuentes":["AHA/ASA"],"version":"core_v2.9"}

{"id":"STROKE_005","tema":"Urgencias","subtema":"EVC isquémico","tipo_decision":"seguridad","enunciado":"Paciente candidato a trombólisis con TA 210/120 mmHg. ¿Conducta correcta?","opciones":[{"id":"A","texto":"Reducir TA a <185/110 mmHg antes de trombólisis","resultado":"correcto","impacto":3},{"id":"B","texto":"Iniciar trombólisis sin modificar TA","resultado":"error_letal","impacto":-6},{"id":"C","texto":"Bajar TA a cifras normales rápidamente","resultado":"error_grave","impacto":-4}],"fuentes":["AHA/ASA Blood Pressure Management"],"version":"core_v2.9"}

{"id":"STROKE_006","tema":"Urgencias","subtema":"EVC isquémico","tipo_decision":"error_critico","enunciado":"Paciente con EVC isquémico que recibió trombólisis. ¿Cuál acción aumenta el riesgo de hemorragia intracraneal?","opciones":[{"id":"A","texto":"Administrar AAS en las primeras 24 horas","resultado":"correcto","impacto":3},{"id":"B","texto":"Monitoreo neurológico estrecho","resultado":"error_grave","impacto":-4},{"id":"C","texto":"Control de TA","resultado":"error_frecuente","impacto":-2}],"fuentes":["AHA/ASA Post-thrombolysis Care"],"version":"core_v2.9"}
